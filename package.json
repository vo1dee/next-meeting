{
  "name": "next-meeting-streamdeck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Next Meeting — glance + one-tap-join calendar plugin for Elgato Stream Deck (free and Pro SKUs from one codebase).",
  "scripts": {
    "build": "rollup -c",
    "build:free": "SKU=free rollup -c",
    "build:pro": "SKU=pro rollup -c",
    "watch:free": "SKU=free rollup -c -w",
    "watch:pro": "SKU=pro rollup -c -w",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@elgato/streamdeck": "^1.4.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-replace": "^6.0.2",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/node": "^20.17.0",
    "rollup": "^4.30.0",
    "tslib": "^2.8.0",
    "typescript": "^5.7.0"
  }
}
